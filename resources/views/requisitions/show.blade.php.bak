@extends('layouts.template')

@push('styles')
<style>
/* ── Layout ──────────────────────────────────────── */
.rrf-page { max-width: 980px; margin: 0 auto; }

/* ── Page header banner ──────────────────────────── */
.rrf-banner {
    background:#fff; border:1px solid #e9ecef; border-radius:10px;
    border-left:5px solid #61ce70; padding:16px 20px;
    margin-bottom:16px; box-shadow:0 1px 4px rgba(0,0,0,.04);
}
.rrf-banner .rrf-ref { font-size:1.15rem; font-weight:800; color:#1a1a2e; letter-spacing:-.02em; }
.rrf-banner .rrf-meta { display:flex; flex-wrap:wrap; gap:14px; margin-top:5px; }
.rrf-banner .rrf-meta-item { display:flex; align-items:center; gap:5px; font-size:0.76rem; color:#6c757d; }
.rrf-banner .rrf-meta-item i { color:#61ce70; font-size:0.72rem; }

/* ── Workflow stepper ────────────────────────────── */
.wf-stepper { background:#fff; border:1px solid #e9ecef; border-radius:10px;
              padding:18px 20px 14px; margin-bottom:16px; box-shadow:0 1px 4px rgba(0,0,0,.04); }
.wf-stepper-inner { display:flex; align-items:flex-start; justify-content:space-between; position:relative; }
.wf-stepper-inner::before {
    content:''; position:absolute; top:15px; left:0; right:0; height:2px;
    background:#e9ecef; z-index:0;
}
.wf-step-item { display:flex; flex-direction:column; align-items:center; gap:6px;
                position:relative; z-index:1; flex:1; }
.wf-step-dot {
    width:32px; height:32px; border-radius:50%; display:flex; align-items:center;
    justify-content:center; font-size:0.68rem; font-weight:700; border:3px solid #e9ecef;
    background:#fff; transition:all .2s;
}
.wf-step-dot.done    { background:#61ce70; border-color:#61ce70; color:#fff; }
.wf-step-dot.active  { background:#fff; border-color:#61ce70; color:#61ce70;
                        box-shadow:0 0 0 4px #61ce7025; }
.wf-step-dot.pending { background:#f8f9fa; border-color:#dee2e6; color:#adb5bd; }
.wf-step-lbl { font-size:0.68rem; font-weight:600; text-align:center; white-space:nowrap; }
.wf-step-lbl.done    { color:#61ce70; }
.wf-step-lbl.active  { color:#2da853; }
.wf-step-lbl.pending { color:#adb5bd; }
/* fill line up to done steps */
.wf-step-item.done::after {
    content:''; position:absolute; top:15px; left:50%; right:-50%; height:2px;
    background:#61ce70; z-index:0;
}

/* ── Section card ────────────────────────────────── */
.rrf-card { border:1px solid #e9ecef; border-radius:10px; margin-bottom:14px;
            overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.04); }
.rrf-card.card-active { border-top:3px solid #61ce70; }
.rrf-card-hdr { display:flex; align-items:center; gap:10px; padding:10px 16px;
                background:#f8f9fa; border-bottom:1px solid #e9ecef; }
.rrf-card-hdr .step-badge { width:24px; height:24px; border-radius:50%;
    background:#61ce70; color:#fff; font-size:0.66rem; font-weight:700;
    display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.rrf-card-hdr .hdr-title { font-size:0.84rem; font-weight:700; color:#1a1a2e; }
.rrf-card-hdr .hdr-sub   { font-size:0.71rem; color:#6c757d; margin-top:1px; }
.rrf-card-body { padding:16px; }
.rrf-card-body.review-active { background:#f7fdf8; }

/* ── Data table ──────────────────────────────────── */
.rrf-tbl { width:100%; border-collapse:collapse; font-size:0.82rem; }
.rrf-tbl th {
    font-size:0.69rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
    color:#6c757d; padding:8px 14px; background:#f8f9fa;
    border-bottom:1px solid #e9ecef; white-space:nowrap; vertical-align:top; width:160px;
}
.rrf-tbl td {
    padding:8px 14px; color:#222; font-weight:500;
    border-bottom:1px solid #f0f0f0; vertical-align:top;
}
.rrf-tbl tr:last-child th,
.rrf-tbl tr:last-child td { border-bottom:none; }
.rrf-tbl tr:nth-child(even) td,
.rrf-tbl tr:nth-child(even) th { background:rgba(0,0,0,.012); }

/* ── Decision cards ──────────────────────────────── */
.dec-card { border:2px solid #dee2e6; border-radius:8px; padding:10px 14px;
            cursor:pointer; transition:all .15s; display:flex; align-items:center; gap:10px; }
.dec-card:hover  { border-color:#61ce70; background:#f4fdf5; }
.dec-card.selected { border-color:#61ce70; background:#f0fdf2; }
.dec-card.danger:hover  { border-color:#dc3545; background:#fff5f5; }
.dec-card.danger.selected { border-color:#dc3545; background:#fff5f5; }
.dec-card input[type=radio] { width:15px; height:15px; accent-color:#61ce70; }
.dec-card .dec-label { font-size:0.82rem; font-weight:600; }
.dec-card .dec-sub   { font-size:0.71rem; color:#6c757d; }

/* ── Signature ───────────────────────────────────── */
.sig-wrap { display:inline-block; border:1px solid #e9ecef; border-radius:6px;
            padding:4px 8px; background:#fff; }
.sig-wrap img { max-height:50px; max-width:130px; object-fit:contain; display:block; }

/* ── Condition chips ─────────────────────────────── */
.cond-chip { display:inline-flex; align-items:center; gap:6px; font-size:0.76rem;
             background:#f0fdf4; border:1px solid #bbf7d0; color:#166534;
             border-radius:20px; padding:4px 12px; font-weight:500; }

/* ── Form helpers ────────────────────────────────── */
.rrf-form-label { font-size:0.79rem; font-weight:600; color:#444; margin-bottom:4px; }
.form-control, .form-select { font-size:0.82rem; }

/* ── Pending / info notices ──────────────────────── */
.rrf-pending { background:#fafafa; border:1px dashed #dee2e6; border-radius:8px;
               padding:12px 16px; font-size:0.81rem; color:#6c757d;
               display:flex; align-items:center; gap:10px; }
.rrf-pending i { font-size:1rem; color:#adb5bd; }

/* ── Section divider label ───────────────────────── */
.sec-divider { font-size:0.68rem; font-weight:700; text-transform:uppercase;
               letter-spacing:.06em; color:#6c757d; margin-bottom:8px;
               padding-bottom:4px; border-bottom:1px solid #e9ecef; }
</style>
@endpush

